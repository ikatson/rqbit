--- crates/librqbit/src/storage/filesystem/opened_file.rs
+++ crates/librqbit/src/storage/filesystem/opened_file.rs
@@ -262,10 +353,59 @@ struct OpenedFileLocked {
     fd: Option<TrackedFile>,
     read_only: bool,
     is_padding: bool,
+    target_len: Option<u64>,
+    length_ensured: bool,
     #[cfg(windows)]
     tried_marking_sparse: bool,
 }
 
+impl OpenedFileLocked {
+    fn is_ready_for_write(&self) -> bool {
+        let ready = self.fd.is_some()
+            && !self.read_only
+            && (self.length_ensured || self.target_len.is_none());
+        #[cfg(windows)]
+        let ready = ready && self.tried_marking_sparse;
+        ready
+    }
+
+    fn prepare_file_for_write(&mut self, f: &File) -> std::io::Result<()> {
+        #[cfg(windows)]
+        if !self.tried_marking_sparse {
+            self.tried_marking_sparse = true;
+            let marked = super::sparse::mark_file_sparse(f);
+            tracing::debug!(path=?self.path, marked, "marking sparse");
+        }
+        if !self.length_ensured {
+            if let Some(target_len) = self.target_len {
+                preallocate_or_set_len(f, target_len)?;
+            }
+            self.length_ensured = true;
+        }
+        Ok(())
+    }
+
+    fn prepare_cached_fd_for_write(&mut self) -> anyhow::Result<()> {
+        #[cfg(windows)]
+        if !self.tried_marking_sparse {
+            let marked = {
+                let f = &self.fd.as_ref().ok_or(Error::FsFileIsNone)?.0;
+                super::sparse::mark_file_sparse(f)
+            };
+            self.tried_marking_sparse = true;
+            tracing::debug!(path=?self.path, marked, "marking sparse");
+        }
+        if !self.length_ensured {
+            if let Some(target_len) = self.target_len {
+                let f = &self.fd.as_ref().ok_or(Error::FsFileIsNone)?.0;
+                preallocate_or_set_len(f, target_len)?;
+            }
+            self.length_ensured = true;
+        }
+        Ok(())
+    }
+}
+
